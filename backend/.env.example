# Copiar este archivo como .env y completar los valores.
# El archivo .env no se sube al repositorio ni se comparte (está en .gitignore)

DATABASE_URL=postgresql://postgres:CLAVE@localhost:5432/foodstore_db

# JWT: clave de al menos 32 caracteres aleatorios
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173